{
  "rules": {
    "siteSettings": {
      ".read": true,
      ".write": true
    },
    "products": {
      ".read": true,
      ".write": true,
      ".indexOn": ["category", "type"]
    },
    "coas": {
      ".read": true,
      ".write": true
    },
    "faqs": {
      ".read": true,
      ".write": true
    },
    "promoCodes": {
      ".read": true,
      ".write": true,
      ".indexOn": ["code"]
    },
    "leads": {
      ".read": true,
      ".write": true
    },
    "orders": {
      ".read": true,
      ".write": true,
      ".indexOn": ["createdAt", "paymentStatus", "deliveryStatus", "customer/email"]
    },
    "customers": {
      ".read": true,
      ".write": true,
      ".indexOn": ["email"]
    }
  }
}
